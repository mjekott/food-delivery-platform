# API location. Must be reachable from the device/simulator, so use your
# machine's LAN IP (NOT localhost) when testing on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.x.x:6000/api
EXPO_PUBLIC_SERVER_URL=http://192.168.x.x:6000

# Google Maps + Places (one key). In Google Cloud enable: Maps SDK for Android,
# Maps SDK for iOS, Places API, and Geocoding API, then restrict the key.
# GOOGLE_MAPS_API_KEY  → build-time (Android native map).
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY → runtime (address autocomplete). Same value.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# PostHog analytics (optional — leave blank to disable).
POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com
