# ── Server ──
PORT=6000
NODE_ENV=development

# ── Database (Postgres) ──
# Matches docker/docker-compose.yml defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_delivery

# ── Auth ──
# Use a long, random string in every environment.
JWT_SECRET=change-me-to-a-long-random-secret

# ── Redis (matches docker/docker-compose.yml) ──
# REDIS_URL takes precedence; else REDIS_HOST/REDIS_PORT are used.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Payments (Paystack) ──
# Test secret key from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── File uploads (UploadThing) ──
# https://uploadthing.com → API Keys
UPLOADTHING_TOKEN=your-uploadthing-token
